# Telegram bot
BOT_TOKEN=123456:ABC-your-bot-token
# Rasm saqlanadigan maxsus kanal/chat ID (bot a'zo bo'lishi kerak)
STORAGE_CHAT_ID=-1001234567890

# Ma'lumotlar bazasi (dev: sqlite; prod: postgresql://user:pass@host/db)
DATABASE_URL=sqlite:///./battlebot.db

# Mini App URL (public HTTPS — deploy'da)
WEBAPP_URL=http://localhost:5173
CORS_ORIGINS=*

# Vaqt mintaqasi (kun oxiri shu bo'yicha)
TIMEZONE=Asia/Tashkent

# Scoring (SPEC.md §4)
POINTS_PER_COMPLETION=1
PENALTY_PER_MISS=0.5
SCORE_FLOOR=0
VERIFY_DEADLINE_HOURS=24
